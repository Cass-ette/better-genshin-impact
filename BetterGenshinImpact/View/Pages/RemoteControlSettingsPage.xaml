<Page x:Class="BetterGenshinImpact.View.Pages.RemoteControlSettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:BetterGenshinImpact.View.Pages"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:pages="clr-namespace:BetterGenshinImpact.ViewModel.Pages"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:i18n="clr-namespace:BetterGenshinImpact.Service.I18n"
      Title="RemoteControlSettingsPage"
      d:DataContext="{d:DesignInstance Type=pages:RemoteControlSettingsPageViewModel}"
      d:DesignHeight="800"
      d:DesignWidth="800"
      ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
      ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      FontFamily="{StaticResource TextThemeFontFamily}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      mc:Ignorable="d">
    <StackPanel Margin="{StaticResource PagePadding}">
        <ui:TextBlock Margin="0,0,0,8"
                      FontTypography="BodyStrong"
                      Text="远程控制设置" />

        <!--  启用远程控制  -->
        <ui:CardExpander Margin="0,0,0,12"
                         ContentPadding="0"
                         Icon="{ui:SymbolIcon Globe16}">
            <ui:CardExpander.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBlock Grid.Row="0"
                                  Grid.Column="0"
                                  FontTypography="Body"
                                  Text="启用远程控制 API"
                                  TextWrapping="Wrap" />
                    <ui:TextBlock Grid.Row="1"
                                  Grid.Column="0"
                                  Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                  Text="通过 HTTP API 远程控制 BetterGI（需重启生效）"
                                  TextWrapping="Wrap" />
                    <ui:ToggleSwitch Grid.Row="0"
                                     Grid.RowSpan="2"
                                     Grid.Column="1"
                                     IsChecked="{Binding Config.RemoteControlConfig.Enabled}" />
                </Grid>
            </ui:CardExpander.Header>

            <StackPanel Margin="56,8,56,16">
                <!-- API 端口 -->
                <ui:CardControl Icon="{ui:SymbolIcon Port20}" Margin="0,0,0,12">
                    <ui:CardControl.Header>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <ui:TextBlock FontTypography="Body"
                                              Text="API 端口" />
                                <ui:TextBlock Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                              Text="本地 HTTP 服务器监听端口（默认 8080）" />
                            </StackPanel>
                            <ui:NumberBox Grid.Column="1"
                                          Width="120"
                                          Minimum="1024"
                                          Maximum="65535"
                                          Value="{Binding Config.RemoteControlConfig.Port}" />
                        </Grid>
                    </ui:CardControl.Header>
                </ui:CardControl>

                <!-- API Token -->
                <ui:CardControl Icon="{ui:SymbolIcon Key20}" Margin="0,0,0,12">
                    <ui:CardControl.Header>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0">
                                <ui:TextBlock FontTypography="Body"
                                              Text="API Token" />
                                <ui:TextBlock Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                              Text="用于验证远程请求的令牌" />
                            </StackPanel>
                            <Grid Grid.Row="1" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:TextBox Grid.Column="0"
                                            IsReadOnly="True"
                                            Text="{Binding Config.RemoteControlConfig.ApiToken}"
                                            FontFamily="Consolas" />
                                <ui:Button Grid.Column="1"
                                           Margin="8,0,0,0"
                                           Content="复制"
                                           Command="{Binding OnCopyTokenCommand}" />
                                <ui:Button Grid.Column="2"
                                           Margin="8,0,0,0"
                                           Content="重新生成"
                                           Command="{Binding OnRegenerateTokenCommand}" />
                            </Grid>
                        </Grid>
                    </ui:CardControl.Header>
                </ui:CardControl>

                <!-- 测试连接 -->
                <ui:CardControl Icon="{ui:SymbolIcon TestBeaker20}" Margin="0,0,0,12">
                    <ui:CardControl.Header>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0">
                                <ui:TextBlock FontTypography="Body"
                                              Text="测试连接" />
                                <ui:TextBlock Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                              Text="测试本地 API 服务器是否正常运行" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Margin="0,8,0,0">
                                <ui:Button Content="测试连接"
                                           Command="{Binding OnTestConnectionCommand}"
                                           Appearance="Primary" />
                                <ui:TextBlock Margin="0,8,0,0"
                                              Text="{Binding TestStatus}"
                                              TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </ui:CardControl.Header>
                </ui:CardControl>

                <!-- 使用说明 -->
                <ui:InfoBar Title="使用说明"
                            Margin="0,0,0,12"
                            IsOpen="True"
                            IsClosable="False"
                            Severity="Informational">
                    <StackPanel>
                        <ui:TextBlock TextWrapping="Wrap">
                            <Run Text="1. 启用远程控制后，BetterGI 会在本地启动 HTTP API 服务器" />
                            <LineBreak />
                            <Run Text="2. 通过 SSH 隧道将本地端口转发到公网服务器：" />
                            <LineBreak />
                            <Run FontFamily="Consolas" Text="   ssh -R 8080:localhost:8080 user@server" />
                            <LineBreak />
                            <Run Text="3. 在手机或其他设备上通过服务器访问控制接口" />
                            <LineBreak />
                            <Run Text="4. 所有请求需在 HTTP Header 中包含：" />
                            <LineBreak />
                            <Run FontFamily="Consolas" Text="   X-API-Token: {your-token}" />
                        </ui:TextBlock>
                        <ui:Button Margin="0,12,0,0"
                                   Content="查看完整文档"
                                   Command="{Binding OnOpenDocumentationCommand}"
                                   Appearance="Secondary" />
                    </StackPanel>
                </ui:InfoBar>

                <!-- API 端点列表 -->
                <ui:InfoBar Title="可用的 API 端点"
                            IsOpen="True"
                            IsClosable="False"
                            Severity="Informational">
                    <StackPanel>
                        <ui:TextBlock FontFamily="Consolas" TextWrapping="Wrap">
                            <Run Text="GET  /api/status   - 获取运行状态" />
                            <LineBreak />
                            <Run Text="POST /api/start    - 启动任务" />
                            <LineBreak />
                            <Run Text="POST /api/stop     - 停止任务" />
                        </ui:TextBlock>
                        <ui:TextBlock Margin="0,8,0,0"
                                      Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                      TextWrapping="Wrap">
                            <Run Text="注意：所有请求需要在 Header 中包含：X-API-Token: {your-token}" />
                        </ui:TextBlock>
                    </StackPanel>
                </ui:InfoBar>
            </StackPanel>
        </ui:CardExpander>
    </StackPanel>
</Page>
